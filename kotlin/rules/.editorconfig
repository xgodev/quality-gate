# Canonical Quality Gate ruleset -- Kotlin (ktlint).
# Enforced by QG via ktlint --editorconfig=<this>.
# The target project's .editorconfig is IGNORED for the gate.
root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
insert_final_newline = true
ktlint_standard = enabled
