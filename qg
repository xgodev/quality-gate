#!/usr/bin/env bash
# QG_CONTRACT_VERSION=1
#
# qg -- deterministic dispatcher. Detects the target project's language(s)
# via <lang>/qg.sh --detect and runs the matching gate(s).
# 100% shell detection, zero AI. The consumer skill ONLY calls this script.
#
# Contract: docs/contract.md, section "Deterministic dispatcher".

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

show_help() {
  cat <<'EOF'
Usage: qg [--base <git-ref>] [options]
     qg --detect

Deterministic dispatcher. Discovers the project's language(s) and runs
the matching <lang>/qg.sh. Forwards ALL flags intact.

Dispatcher-specific options:
  --detect    Lists the detected slugs (one per line). exit 0 if >=1,
              exit 3 if no supported language.

Other flags (--base, --format, --cov-margin, --log-dir, ...) are
forwarded to the <lang>/qg.sh. See docs/contract.md.

Exit codes:
  0  all gates passed (or bypassed/fast-path)
  1  >=1 gate regressed / absolute threshold violated
  2  setup/tool error in some gate
  3  no supported language detected (dispatcher)

Aggregate verdict precedence: 2 > 1 > 3 > 0.
EOF
}

# Detects whether --detect was requested (without consuming the other args,
# which are forwarded intact to <lang>/qg.sh).
DISPATCH_DETECT_ONLY=0
for a in "$@"; do
  case "$a" in
    --detect) DISPATCH_DETECT_ONLY=1 ;;
    -h|--help) show_help; exit 0 ;;
  esac
done

# --- .qg.yaml projects: (monorepo) -------------------------------------------
# Closed schema per item: path (required), lang (optional). Unknown
# key -> exit 2. If projects: exists, USES ONLY that list.
QG_YAML="$TARGET/.qg.yaml"
PROJECTS_RAW=""        # "path|lang" lines (lang may be empty)
HAS_PROJECTS=0

if [ -f "$QG_YAML" ]; then
  in_projects=0
  cur_path=""
  cur_lang=""
  flush_item() {
    if [ -n "$cur_path" ]; then
      PROJECTS_RAW="${PROJECTS_RAW}${cur_path}|${cur_lang}"$'\n'
    fi
    cur_path=""
    cur_lang=""
  }
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$in_projects" = "1" ]; then
      case "$line" in
        "  - path:"*)
          flush_item
          cur_path=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*path:[[:space:]]*"?([^"#]*)"?.*/\1/' | sed -E 's/[[:space:]]+$//')
          ;;
        "    path:"*)
          cur_path=$(echo "$line" | sed -E 's/^[[:space:]]*path:[[:space:]]*"?([^"#]*)"?.*/\1/' | sed -E 's/[[:space:]]+$//')
          ;;
        "    lang:"*)
          cur_lang=$(echo "$line" | sed -E 's/^[[:space:]]*lang:[[:space:]]*"?([^"#]*)"?.*/\1/' | sed -E 's/[[:space:]]+$//')
          ;;
        "  - "*)
          # inline item like "  - foo:" -> unknown key
          key=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*([a-zA-Z_]+):.*/\1/')
          case "$key" in
            path|lang) ;;
            *)
              echo "::error::.qg.yaml: projects[] unknown key: $key" >&2
              exit 2
              ;;
          esac
          ;;
        "    "[a-zA-Z_]*":"*)
          key=$(echo "$line" | sed -E 's/^[[:space:]]*([a-zA-Z_]+):.*/\1/')
          case "$key" in
            path|lang) ;;
            *)
              echo "::error::.qg.yaml: projects[] unknown key: $key" >&2
              exit 2
              ;;
          esac
          ;;
        ""|cov_margin:*|skip_metrics:*|extra_fast_path_paths:*|absolute_thresholds:*)
          flush_item
          in_projects=0
          ;;
      esac
    fi
    case "$line" in
      "projects:"*) in_projects=1; HAS_PROJECTS=1 ;;
    esac
  done < "$QG_YAML"
  if [ "$in_projects" = "1" ]; then
    flush_item
  fi
fi

# --- Discovery -------------------------------------------------------------
# Emits "slug|workdir" lines for each gate to run.
discover() {
  if [ "$HAS_PROJECTS" = "1" ]; then
    while IFS='|' read -r p l; do
      [ -z "$p" ] && continue
      local wd="$TARGET/$p"
      if [ ! -d "$wd" ]; then
        echo "::error::.qg.yaml projects: nonexistent path: $p" >&2
        continue
      fi
      if [ -n "$l" ]; then
        local s="$ROOT/$l/qg.sh"
        if [ -x "$s" ] && ( cd "$wd" && "$s" --detect ) >/dev/null 2>&1; then
          echo "${l}|${wd}"
        fi
      else
        local s slug
        for s in "$ROOT"/*/qg.sh; do
          [ -x "$s" ] || continue
          if slug=$( cd "$wd" && "$s" --detect 2>/dev/null ); then
            [ -n "$slug" ] && echo "${slug}|${wd}"
          fi
        done
      fi
    done <<< "$PROJECTS_RAW"
  else
    local s slug
    for s in "$ROOT"/*/qg.sh; do
      [ -x "$s" ] || continue
      if slug=$( cd "$TARGET" && "$s" --detect 2>/dev/null ); then
        [ -n "$slug" ] && echo "${slug}|${TARGET}"
      fi
    done
  fi
}

MATCHES=$(discover)

# --- qg --detect: only lists slugs -------------------------------------------
if [ "$DISPATCH_DETECT_ONLY" = "1" ]; then
  if [ -z "$MATCHES" ]; then
    echo "::error::no supported language detected" >&2
    exit 3
  fi
  echo "$MATCHES" | awk -F'|' 'NF { print $1 }' | sort -u
  exit 0
fi

# --- 0 matches -------------------------------------------------------------
if [ -z "$MATCHES" ]; then
  echo "::error::no supported language detected" >&2
  exit 3
fi

N_MATCHES=$(echo "$MATCHES" | grep -c . || true)

# Discover --format from the forwarded arguments (to envelope JSON when N>1).
FMT="text"
prev=""
for a in "$@"; do
  if [ "$prev" = "--format" ]; then FMT="$a"; fi
  prev="$a"
done
[ -n "${QG_FORMAT:-}" ] && [ "$FMT" = "text" ] && FMT="$QG_FORMAT"

# --- 1 match: forward directly, exit code intact ----------------------------
if [ "$N_MATCHES" -eq 1 ]; then
  slug=$(echo "$MATCHES" | head -1 | cut -d'|' -f1)
  wd=$(echo "$MATCHES" | head -1 | cut -d'|' -f2-)
  ( cd "$wd" && "$ROOT/$slug/qg.sh" "$@" )
  exit $?
fi

# --- N matches: run all, aggregate ----------------------------------------
# Exit precedence: 2 > 1 > 3 > 0.
worst_exit() {
  local a="$1" b="$2"
  for code in 2 1 3; do
    if [ "$a" = "$code" ] || [ "$b" = "$code" ]; then
      echo "$code"; return
    fi
  done
  echo 0
}

verdict_for_exit() {
  case "$1" in
    2) echo "failed" ;;
    1) echo "regressed" ;;
    3) echo "failed" ;;
    *) echo "passed" ;;
  esac
}

agg_exit=0
results_json=""

while IFS='|' read -r slug wd; do
  [ -z "$slug" ] && continue
  if [ "$FMT" = "json" ]; then
    out=$( cd "$wd" && "$ROOT/$slug/qg.sh" "$@" )
    rc=$?
    results_json="${results_json}${results_json:+,}${out}"
  else
    ( cd "$wd" && "$ROOT/$slug/qg.sh" "$@" )
    rc=$?
  fi
  agg_exit=$(worst_exit "$agg_exit" "$rc")
done <<< "$MATCHES"

if [ "$FMT" = "json" ]; then
  agg_verdict=$(verdict_for_exit "$agg_exit")
  jq -n \
    --arg av "$agg_verdict" \
    --argjson results "[${results_json}]" \
    '{ schema_version: "1.1", aggregate_verdict: $av, results: $results }'
else
  echo
  if [ "$agg_exit" -eq 0 ]; then
    echo "::notice::dispatcher: all gates passed (${N_MATCHES} languages)"
  else
    echo "::error::dispatcher: at least one gate failed (aggregate verdict, exit $agg_exit)"
  fi
fi

exit "$agg_exit"
