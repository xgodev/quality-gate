#!/usr/bin/env bash
# QG_CONTRACT_VERSION=1
#
# qg -- dispatcher deterministico. Detecta a(s) linguagem(s) do projeto-alvo
# via <lang>/qg.sh --detect e roda o(s) gate(s) correspondente(s).
# Deteccao 100% shell, zero IA. A skill consumer SO chama este script.
#
# Contrato: docs/contract.md, secao "Dispatcher deterministico".

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

show_help() {
  cat <<'EOF'
Uso: qg [--base <git-ref>] [opcoes]
     qg --detect

Dispatcher deterministico. Descobre a(s) linguagem(s) do projeto e roda
o(s) <lang>/qg.sh correspondente(s). Repassa TODAS as flags intactas.

Opcoes especiais do dispatcher:
  --detect    Lista os slugs detectados (um por linha). exit 0 se >=1,
              exit 3 se nenhuma linguagem suportada.

Demais flags (--base, --format, --cov-margin, --log-dir, ...) sao
repassadas para o(s) <lang>/qg.sh. Ver docs/contract.md.

Exit codes:
  0  todos os gates passaram (ou bypassed/fast-path)
  1  >=1 gate regrediu / threshold absoluto violado
  2  erro de setup/ferramenta em algum gate
  3  nenhuma linguagem suportada detectada (dispatcher)

Precedencia do veredito agregado: 2 > 1 > 3 > 0.
EOF
}

# Detecta se --detect foi pedido (sem consumir os demais args, que sao
# repassados intactos para <lang>/qg.sh).
DISPATCH_DETECT_ONLY=0
for a in "$@"; do
  case "$a" in
    --detect) DISPATCH_DETECT_ONLY=1 ;;
    -h|--help) show_help; exit 0 ;;
  esac
done

# --- .qg.yaml projects: (monorepo) -------------------------------------------
# Schema fechado por item: path (obrigatorio), lang (opcional). Chave
# desconhecida -> exit 2. Se projects: existe, USA APENAS essa lista.
QG_YAML="$TARGET/.qg.yaml"
PROJECTS_RAW=""        # linhas "path|lang" (lang pode ser vazio)
HAS_PROJECTS=0

if [ -f "$QG_YAML" ]; then
  in_projects=0
  cur_path=""
  cur_lang=""
  flush_item() {
    if [ -n "$cur_path" ]; then
      PROJECTS_RAW="${PROJECTS_RAW}${cur_path}|${cur_lang}"$'\n'
    fi
    cur_path=""
    cur_lang=""
  }
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$in_projects" = "1" ]; then
      case "$line" in
        "  - path:"*)
          flush_item
          cur_path=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*path:[[:space:]]*"?([^"#]*)"?.*/\1/' | sed -E 's/[[:space:]]+$//')
          ;;
        "    path:"*)
          cur_path=$(echo "$line" | sed -E 's/^[[:space:]]*path:[[:space:]]*"?([^"#]*)"?.*/\1/' | sed -E 's/[[:space:]]+$//')
          ;;
        "    lang:"*)
          cur_lang=$(echo "$line" | sed -E 's/^[[:space:]]*lang:[[:space:]]*"?([^"#]*)"?.*/\1/' | sed -E 's/[[:space:]]+$//')
          ;;
        "  - "*)
          # item inline tipo "  - foo:" -> chave desconhecida
          key=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*([a-zA-Z_]+):.*/\1/')
          case "$key" in
            path|lang) ;;
            *)
              echo "::error::.qg.yaml: projects[] chave desconhecida: $key" >&2
              exit 2
              ;;
          esac
          ;;
        "    "[a-zA-Z_]*":"*)
          key=$(echo "$line" | sed -E 's/^[[:space:]]*([a-zA-Z_]+):.*/\1/')
          case "$key" in
            path|lang) ;;
            *)
              echo "::error::.qg.yaml: projects[] chave desconhecida: $key" >&2
              exit 2
              ;;
          esac
          ;;
        ""|cov_margin:*|skip_metrics:*|extra_fast_path_paths:*|absolute_thresholds:*)
          flush_item
          in_projects=0
          ;;
      esac
    fi
    case "$line" in
      "projects:"*) in_projects=1; HAS_PROJECTS=1 ;;
    esac
  done < "$QG_YAML"
  if [ "$in_projects" = "1" ]; then
    flush_item
  fi
fi

# --- Descoberta -------------------------------------------------------------
# Emite linhas "slug|workdir" para cada gate a rodar.
discover() {
  if [ "$HAS_PROJECTS" = "1" ]; then
    while IFS='|' read -r p l; do
      [ -z "$p" ] && continue
      local wd="$TARGET/$p"
      if [ ! -d "$wd" ]; then
        echo "::error::.qg.yaml projects: path inexistente: $p" >&2
        continue
      fi
      if [ -n "$l" ]; then
        local s="$ROOT/$l/qg.sh"
        if [ -x "$s" ] && ( cd "$wd" && "$s" --detect ) >/dev/null 2>&1; then
          echo "${l}|${wd}"
        fi
      else
        local s slug
        for s in "$ROOT"/*/qg.sh; do
          [ -x "$s" ] || continue
          if slug=$( cd "$wd" && "$s" --detect 2>/dev/null ); then
            [ -n "$slug" ] && echo "${slug}|${wd}"
          fi
        done
      fi
    done <<< "$PROJECTS_RAW"
  else
    local s slug
    for s in "$ROOT"/*/qg.sh; do
      [ -x "$s" ] || continue
      if slug=$( cd "$TARGET" && "$s" --detect 2>/dev/null ); then
        [ -n "$slug" ] && echo "${slug}|${TARGET}"
      fi
    done
  fi
}

MATCHES=$(discover)

# --- qg --detect: so lista slugs -------------------------------------------
if [ "$DISPATCH_DETECT_ONLY" = "1" ]; then
  if [ -z "$MATCHES" ]; then
    echo "::error::nenhuma linguagem suportada detectada" >&2
    exit 3
  fi
  echo "$MATCHES" | awk -F'|' 'NF { print $1 }' | sort -u
  exit 0
fi

# --- 0 matches -------------------------------------------------------------
if [ -z "$MATCHES" ]; then
  echo "::error::nenhuma linguagem suportada detectada" >&2
  exit 3
fi

N_MATCHES=$(echo "$MATCHES" | grep -c . || true)

# Descobre --format dos argumentos repassados (para envelopar JSON em N>1).
FMT="text"
prev=""
for a in "$@"; do
  if [ "$prev" = "--format" ]; then FMT="$a"; fi
  prev="$a"
done
[ -n "${QG_FORMAT:-}" ] && [ "$FMT" = "text" ] && FMT="$QG_FORMAT"

# --- 1 match: repassa direto, exit code intacto ----------------------------
if [ "$N_MATCHES" -eq 1 ]; then
  slug=$(echo "$MATCHES" | head -1 | cut -d'|' -f1)
  wd=$(echo "$MATCHES" | head -1 | cut -d'|' -f2-)
  ( cd "$wd" && "$ROOT/$slug/qg.sh" "$@" )
  exit $?
fi

# --- N matches: roda todos, agrega ----------------------------------------
# Precedencia de exit: 2 > 1 > 3 > 0.
worst_exit() {
  local a="$1" b="$2"
  for code in 2 1 3; do
    if [ "$a" = "$code" ] || [ "$b" = "$code" ]; then
      echo "$code"; return
    fi
  done
  echo 0
}

verdict_for_exit() {
  case "$1" in
    2) echo "failed" ;;
    1) echo "regressed" ;;
    3) echo "failed" ;;
    *) echo "passed" ;;
  esac
}

agg_exit=0
results_json=""

while IFS='|' read -r slug wd; do
  [ -z "$slug" ] && continue
  if [ "$FMT" = "json" ]; then
    out=$( cd "$wd" && "$ROOT/$slug/qg.sh" "$@" )
    rc=$?
    results_json="${results_json}${results_json:+,}${out}"
  else
    ( cd "$wd" && "$ROOT/$slug/qg.sh" "$@" )
    rc=$?
  fi
  agg_exit=$(worst_exit "$agg_exit" "$rc")
done <<< "$MATCHES"

if [ "$FMT" = "json" ]; then
  agg_verdict=$(verdict_for_exit "$agg_exit")
  jq -n \
    --arg av "$agg_verdict" \
    --argjson results "[${results_json}]" \
    '{ schema_version: "1.1", aggregate_verdict: $av, results: $results }'
else
  echo
  if [ "$agg_exit" -eq 0 ]; then
    echo "::notice::dispatcher: todos os gates passaram (${N_MATCHES} linguagens)"
  else
    echo "::error::dispatcher: ao menos um gate falhou (veredito agregado, exit $agg_exit)"
  fi
fi

exit "$agg_exit"
