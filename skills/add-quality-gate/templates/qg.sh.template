#!/usr/bin/env bash
# QG_CONTRACT_VERSION=1
#
# {{LANGUAGE_SLUG}}/qg.sh -- Quality Gate for {{LANGUAGE_NAME}}
#
# Complies with the contract in docs/contract.md (version 1.x). Compares the 6
# reserved metrics (fmt, lint, build, test, complexity, coverage) between the
# current state and a base ref. Fails only if the PR worsens some metric.
#
# TODO(template): Remove this comment after filling in LANGUAGE_SLUG
# and LANGUAGE_NAME. Line 2 (QG_CONTRACT_VERSION) is LITERAL -- do not add
# text before or after on that line; the validator does an exact match.

set -uo pipefail

QG_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/measure.sh
source "$QG_SCRIPT_DIR/lib/measure.sh"
# shellcheck source=lib/output.sh
source "$QG_SCRIPT_DIR/lib/output.sh"

show_help() {
  cat <<'EOF'
Usage: {{LANGUAGE_SLUG}}/qg.sh [--base <git-ref>] [options]
       {{LANGUAGE_SLUG}}/qg.sh --detect

Options:
  --detect              Detects whether the language exists at the root; prints
                        slug + exit 0 if yes, exit 1 if not. Short-circuits everything.
  --base <ref>          Ref to compare against (e.g. origin/main). Absent -> absolute mode.
  --baseline-dir <dir>  Path to an already-prepared baseline.
  --cov-margin <pp>     Coverage tolerance in pp. Default: 1.0
  --log-dir <dir>       Where to write logs. Default: target/qg-logs
  --refresh-baseline    Re-extract baseline even if a cache exists.
  --force-full          Skip fast-path.
  --format text|json    Output format. Default: text.
  -h, --help            This message.

Equivalent environment variables: QG_BASE_REF, QG_BASELINE_DIR, QG_COV_MARGIN,
QG_LOG_DIR, QG_REFRESH_BASELINE, QG_FORCE_FULL, QG_FORMAT, QG_BYPASS_REASON.

More details: docs/contract.md
EOF
}

# Defaults from env vars
QG_BASE_REF_ARG="${QG_BASE_REF:-}"
QG_BASELINE_DIR_ARG="${QG_BASELINE_DIR:-}"
QG_COV_MARGIN_ARG="${QG_COV_MARGIN:-1.0}"
QG_LOG_DIR_ARG="${QG_LOG_DIR:-target/qg-logs}"
QG_REFRESH_BASELINE_ARG="${QG_REFRESH_BASELINE:-0}"
QG_FORCE_FULL_ARG="${QG_FORCE_FULL:-0}"
QG_FORMAT_ARG="${QG_FORMAT:-text}"
QG_DETECT_ARG=0

while [ $# -gt 0 ]; do
  case "$1" in
    --detect)
      QG_DETECT_ARG=1
      shift
      ;;
    --base)
      QG_BASE_REF_ARG="${2:-}"
      shift 2
      ;;
    --baseline-dir)
      QG_BASELINE_DIR_ARG="${2:-}"
      shift 2
      ;;
    --cov-margin)
      QG_COV_MARGIN_ARG="${2:-}"
      shift 2
      ;;
    --log-dir)
      QG_LOG_DIR_ARG="${2:-}"
      shift 2
      ;;
    --refresh-baseline)
      QG_REFRESH_BASELINE_ARG=1
      shift
      ;;
    --force-full)
      QG_FORCE_FULL_ARG=1
      shift
      ;;
    --format)
      QG_FORMAT_ARG="${2:-}"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "::error::unknown argument: $1" >&2
      show_help >&2
      exit 2
      ;;
  esac
done

# --detect: short-circuits BEFORE any validation/prereq.
# qg_lang_present MUST be in lib/measure.sh (same sentinel as the baseline).
if [ "$QG_DETECT_ARG" = "1" ]; then
  qg_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  if qg_lang_present "$qg_root"; then
    echo "{{LANGUAGE_SLUG}}"
    exit 0
  fi
  exit 1
fi

# --base absent (and no QG_BASE_REF) -> ABSOLUTE MODE (not an error, not exit 2).
QG_ABSOLUTE_MODE=0
if [ -z "$QG_BASE_REF_ARG" ]; then
  QG_ABSOLUTE_MODE=1
fi

case "$QG_FORMAT_ARG" in
  text|json) ;;
  *)
    echo "::error::--format must be 'text' or 'json' (got: '$QG_FORMAT_ARG')" >&2
    exit 2
    ;;
esac

if ! awk -v m="$QG_COV_MARGIN_ARG" 'BEGIN { exit !(m+0 == m) }' 2>/dev/null; then
  echo "::error::--cov-margin must be numeric (got: '$QG_COV_MARGIN_ARG')" >&2
  exit 2
fi

# TODO(template): prereq check.
# Add ONE line per mandatory tool. Use the form "command -v <bin>".
# For tools that depend on another (e.g. cargo-llvm-cov depends on cargo),
# guard the sub-check with an if that validates the root binary first.
# For tools that require an auth env var (e.g. SONAR_TOKEN for SonarQube),
# validate the env var HERE too -- same error if missing (exit 2).
#
# LAW (see docs/contract.md): EVERY missing-tool message MUST teach how to
# install it on Linux AND macOS, in the format:
#   <cause> -- install: '<linux cmd>' (Linux) / '<macOS cmd>' (macOS) (<consequence>)
check_prereqs() {
  local missing=()
  command -v {{PRIMARY_BUILD_TOOL}} >/dev/null 2>&1 || missing+=("{{PRIMARY_BUILD_TOOL}} -- install: '{{PRIMARY_BUILD_TOOL_INSTALL_LINUX}}' (Linux) / '{{PRIMARY_BUILD_TOOL_INSTALL_MACOS}}' (macOS) ({{PRIMARY_BUILD_TOOL_CONSEQUENCE}})")
  command -v jq >/dev/null 2>&1 || missing+=("jq (JSON parser) -- install: 'apt install jq' (Linux) / 'brew install jq' (macOS) (without jq the gate cannot parse metrics)")
  command -v git >/dev/null 2>&1 || missing+=("git -- install: 'apt install git' (Linux) / 'brew install git' (macOS) (without git there is no baseline/diff)")
  command -v awk >/dev/null 2>&1 || missing+=("awk -- install: 'apt install gawk' (Linux) / 'brew install gawk' (macOS) (without awk numeric parsing breaks)")
  command -v tar >/dev/null 2>&1 || missing+=("tar -- install: 'apt install tar' (Linux) / preinstalled (macOS) (without tar there is no baseline extraction)")

  # TODO(template): add language-specific prereqs here.
  # Example (Rust): cargo llvm-cov --version >/dev/null 2>&1 || missing+=("cargo-llvm-cov")
  # Example (Java/Sonar): [ -n "${SONAR_TOKEN:-}" ] || missing+=("SONAR_TOKEN env var")
  {{EXTRA_PREREQ_CHECKS}}

  if [ ${#missing[@]} -gt 0 ]; then
    for tool in "${missing[@]}"; do
      echo "::error::missing tool: $tool" >&2
    done
    exit 2
  fi
}

check_prereqs

mkdir -p "$QG_LOG_DIR_ARG"

# Governed bypass -- DO NOT REMOVE. DO NOT ADD code that sets QG_BYPASS_REASON.
# A bypass is the human user's decision, never the skill's nor the gate's.
handle_bypass() {
  local reason="$1"
  local fmt="$2"
  local log_dir="$3"
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "<detached>")
  local user
  user=$(git config user.email 2>/dev/null || echo "<unknown>")
  local ts
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  printf '%s\tbranch=%s\tuser=%s\treason=%s\n' "$ts" "$branch" "$user" "$reason" \
    >> "$log_dir/bypass.log"

  if [ "$fmt" = "json" ]; then
    cat <<EOF
{
  "schema_version": "1.1",
  "mode": "comparative",
  "language": "{{LANGUAGE_SLUG}}",
  "branch": "$branch",
  "base_ref": "$QG_BASE_REF_ARG",
  "started_at": "$ts",
  "duration_seconds": 0,
  "verdict": "bypassed",
  "bypass_reason": "$reason",
  "metrics": []
}
EOF
  else
    cat <<EOF
=== Quality Gate -- {{LANGUAGE_SLUG}} ===
  branch:        $branch
  base ref:      $QG_BASE_REF_ARG

::warning::QG bypass active -- reason: $reason
::warning::This run did not validate metrics. Audit log: $log_dir/bypass.log
EOF
  fi
  exit 0
}

if [ -n "${QG_BYPASS_REASON:-}" ]; then
  handle_bypass "$QG_BYPASS_REASON" "$QG_FORMAT_ARG" "$QG_LOG_DIR_ARG"
fi

# Optional .qg.yaml -- closed schema, same logic as rust/qg.sh.
# TODO(template): copy the .qg.yaml parse block from rust/qg.sh unchanged,
# INCLUDING the absolute_thresholds sub-block (parses QG_ABS_THRESHOLDS_RAW;
# allowed keys = reserved metrics THIS language measures + extras).
# (The block is language-agnostic; kept identical across all gates.)
QG_YAML_FILE="${QG_YAML_FILE:-.qg.yaml}"
QG_YAML_EXTRA_FAST_PATH=""
QG_YAML_SKIP_METRICS_RAW=""
QG_ABS_THRESHOLDS_RAW=""
# {{QG_YAML_PARSE_BLOCK}}

# Absolute-threshold lookup by metric name. Empty = not defined.
qg_abs_threshold() {
  local name="$1"
  printf '%s' "$QG_ABS_THRESHOLDS_RAW" | grep -E "^${name}=" | head -1 | sed -E "s/^${name}=//"
}

# --- ABSOLUTE MODE -----------------------------------------------------------
# Skips baseline, fast-path and the language-absent check. Measures . once.
# TODO(template): copy the "if [ \"$QG_ABSOLUTE_MODE\" = \"1\" ]" block from
# rust/qg.sh (or from a binding already migrated to v1.1), ADJUSTING the slug in
# the messages, the list of measured metrics (omit the ones the language does not
# measure, e.g. Swift without complexity) and calling qg_resolve_deps "." before
# measuring. render_absolute_json/render_absolute_text live in lib/output.sh.
if [ "$QG_ABSOLUTE_MODE" = "1" ]; then
  mkdir -p "$QG_LOG_DIR_ARG"
  if ! qg_resolve_deps "." "$QG_LOG_DIR_ARG/abs-deps.log"; then
    echo "::error::failed to resolve {{LANGUAGE_SLUG}} dependencies -- see $QG_LOG_DIR_ARG/abs-deps.log" >&2
    exit 2
  fi
  echo "-- measuring (no baseline) --" >&2
  abs_fmt=$(count_fmt_errors "." "$QG_LOG_DIR_ARG/abs-fmt.log")
  abs_lint=$(count_lint_errors "." "$QG_LOG_DIR_ARG/abs-lint.log")
  abs_build=$(count_build_errors "." "$QG_LOG_DIR_ARG/abs-build.log")
  abs_test=$(count_test_failures "." "$QG_LOG_DIR_ARG/abs-test.log")
  abs_complex=$(count_complexity "." "$QG_LOG_DIR_ARG/abs-complex.log")
  abs_cov=$(measure_coverage "." "$QG_LOG_DIR_ARG/abs-cov.json")

  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "<detached>")
  started_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  duration=$SECONDS

  t_fmt=$(qg_abs_threshold fmt)
  t_lint=$(qg_abs_threshold lint)
  t_build=$(qg_abs_threshold build)
  t_test=$(qg_abs_threshold test)
  t_complex=$(qg_abs_threshold complexity)
  t_cov=$(qg_abs_threshold coverage)

  if [ "$QG_FORMAT_ARG" = "json" ]; then
    render_absolute_json "$branch" "$started_at" "$duration" \
      fmt "$abs_fmt" "$t_fmt" count \
      lint "$abs_lint" "$t_lint" count \
      build "$abs_build" "$t_build" count \
      test "$abs_test" "$t_test" count \
      complexity "$abs_complex" "$t_complex" count \
      coverage "$abs_cov" "$t_cov" cov
    exit $?
  else
    render_absolute_text "$branch" "$started_at" "$duration" "$QG_LOG_DIR_ARG" \
      "fmt" "$abs_fmt" "$t_fmt" count \
      "lint" "$abs_lint" "$t_lint" count \
      "build" "$abs_build" "$t_build" count \
      "test fails" "$abs_test" "$t_test" count \
      "complexity" "$abs_complex" "$t_complex" count \
      "coverage" "$abs_cov" "$t_cov" cov
    exit $?
  fi
fi

# TODO(template): fast-path regex -- YOUR language's source files.
# Example (Rust): '\.rs$|^Cargo\.|build\.rs$|^rust-toolchain'
# Example (Go):   '\.go$|^go\.(mod|sum)$'
# Example (Java): '\.java$|^pom\.xml$|^build\.gradle(\.kts)?$|^settings\.gradle(\.kts)?$'
LANG_PATH_RE='{{FAST_PATH_REGEX}}'

if [ -n "$QG_YAML_EXTRA_FAST_PATH" ]; then
  PATH_RE_EXTRA="${LANG_PATH_RE}${QG_YAML_EXTRA_FAST_PATH}"
else
  PATH_RE_EXTRA="$LANG_PATH_RE"
fi

if [ "$QG_FORCE_FULL_ARG" != "1" ]; then
  git fetch origin --quiet 2>/dev/null || true
  committed_files=$(git diff --name-only "$QG_BASE_REF_ARG...HEAD" 2>/dev/null || true)
  staged_files=$(git diff --cached --name-only 2>/dev/null || true)
  worktree_files=$(git diff --name-only 2>/dev/null || true)
  changed_files=$(printf '%s\n%s\n%s\n' "$committed_files" "$staged_files" "$worktree_files" \
                  | sort -u | sed '/^$/d')

  if [ -n "$changed_files" ] && ! echo "$changed_files" | grep -qE "$PATH_RE_EXTRA"; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "<detached>")
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    if [ "$QG_FORMAT_ARG" = "json" ]; then
      cat <<EOF
{
  "schema_version": "1.1",
  "mode": "comparative",
  "language": "{{LANGUAGE_SLUG}}",
  "branch": "$branch",
  "base_ref": "$QG_BASE_REF_ARG",
  "started_at": "$ts",
  "duration_seconds": 1,
  "verdict": "passed",
  "bypass_reason": null,
  "metrics": []
}
EOF
    else
      cat <<EOF
=== Quality Gate (fast-path) ===
  branch:        $branch
  base ref:      $QG_BASE_REF_ARG
  scope:         no {{LANGUAGE_NAME}} files touched -- skipping heavy gates
  override:      QG_FORCE_FULL=1 to run the full gate

-- modified files --
$(echo "$changed_files" | sed 's/^/  /')

OK fast-path passed (no {{LANGUAGE_NAME}} to measure)
EOF
    fi

    # Syntax check of modified shell scripts (cheap cross-language catch)
    shell_files=$(echo "$changed_files" | grep -E '\.sh$' || true)
    if [ -n "$shell_files" ]; then
      while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ ! -f "$f" ] && continue
        if ! bash -n "$f" 2>&1; then
          echo "::error::syntax error in $f" >&2
          exit 1
        fi
      done <<< "$shell_files"
    fi

    exit 0
  fi
fi

prepare_baseline() {
  local target="$1"
  rm -rf "$target"
  mkdir -p "$target"
  git fetch origin --quiet 2>/dev/null || true
  if ! git archive "$QG_BASE_REF_ARG" 2>/dev/null | tar -xC "$target"; then
    echo "::error::failed to extract '$QG_BASE_REF_ARG' via git archive -- try 'git fetch origin'" >&2
    return 1
  fi
}

if [ -z "$QG_BASELINE_DIR_ARG" ]; then
  QG_BASELINE_DIR_ARG="/tmp/qg-baseline-{{LANGUAGE_SLUG}}"
  if [ ! -d "$QG_BASELINE_DIR_ARG" ] || [ "$QG_REFRESH_BASELINE_ARG" = "1" ]; then
    prepare_baseline "$QG_BASELINE_DIR_ARG" || exit 2
  fi
elif [ ! -d "$QG_BASELINE_DIR_ARG" ]; then
  echo "::error::--baseline-dir '$QG_BASELINE_DIR_ARG' does not exist" >&2
  exit 2
fi

QG_BASELINE_DIR_ARG=$(cd "$QG_BASELINE_DIR_ARG" && pwd)

# TODO(template): ASCII sentinel at the root that confirms the language exists
# in the baseline. Examples:
#   Rust:   Cargo.toml
#   Go:     go.mod
#   Python: pyproject.toml
#   Java:   pom.xml (Maven) OR build.gradle (Gradle)
#   Node:   package.json
# If the language does not exist in the baseline, the gate emits a warning + exit 0.
# It does NOT try to measure in an empty baseline.
if [ ! -f "$QG_BASELINE_DIR_ARG/{{BASELINE_SENTINEL_FILE}}" ]; then
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "<detached>")
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  if [ "$QG_FORMAT_ARG" = "json" ]; then
    cat <<EOF
{
  "schema_version": "1.1",
  "mode": "comparative",
  "language": "{{LANGUAGE_SLUG}}",
  "branch": "$branch",
  "base_ref": "$QG_BASE_REF_ARG",
  "started_at": "$ts",
  "duration_seconds": 0,
  "verdict": "passed",
  "bypass_reason": null,
  "metrics": []
}
EOF
  else
    echo "::warning::language absent in baseline ({{BASELINE_SENTINEL_FILE}} not found in $QG_BASELINE_DIR_ARG) -- gate skipped" >&2
  fi
  exit 0
fi

mkdir -p "$QG_LOG_DIR_ARG"

# TODO(template): measurements block.
#
# TAMPER-RESISTANCE (LAW 0.2 of the add-quality-gate skill, contract section
# "Tamper-resistance"): this gate enforces ITS OWN ruleset. BEFORE touching
# here, make sure that:
#  - <lang>/rules/ exists with the canonical config of the tool(s);
#  - lib/measure.sh defines qg_ruleset_dir() returning
#    ${QG_RULESET_DIR:-<absolute base captured at source-time>/rules};
#  - each count_* invokes the tool with --config/CLIPPY_CONF_DIR/-c/etc.
#    pointing at $(qg_ruleset_dir) AND with the flag that ignores local config
#    (e.g. --no-config-lookup, --isolated not-applicable-to-all, --config
#    with an explicit file). NEVER let the tool discover the target
#    project's config. QG_RULESET_DIR only comes from an external env, never from .qg.yaml.
#  Validate with a loosened-config fixture (checklist step 17e).
#
# CANONICAL IGNORE (LAW 0.2.1 of the skill, contract LAW "fmt/lint/complexity
# measure SOURCE CODE"): fmt/lint/complexity measure SOURCE, never a generated/
# vendored artifact. If count_fmt/count_lint/count_complexity scans files
# by path (glob ./**/*, find, a tool without build-system scope),
# EXCLUDE QG's canonical ignore (tamper-proof: NEVER .eslintignore/
# .prettierignore/.gitignore/the project's .qg.yaml): node_modules dist build
# out .next .nuxt .expo coverage .turbo .cache (+ .venv/venv Python,
# vendor Go) and *.min.js *.min.css *.bundle.js *.chunk.js *-lock.json *.map.
# Mechanism: global `ignores` block (eslint), --ignore-path .prettierignore,
# extend-exclude (ruff), -i/-e/-ignore (radon/gocyclo) or an output
# filter + prune in the find helper. A tool ALREADY build-system scoped
# (cargo, mvn-pmd -d src, ktlint src/**, detekt --input src) or that already
# excludes the generated output (swift .build/): NO anti-pattern, do not gold-plate.
# Validate with a minified build/ + clean src/ fixture (step 17e-bis).
#
# DISPATCHER (LAW 0.3): this script's exit codes are 0|1|2. exit 3 is
# dispatcher-exclusive (the root `qg`, no language detected) --
# NEVER emit exit 3 from here. --detect prints slug+exit 0 / nothing+exit 1.
#
# RULES:
# - Each count_* returns an integer >= 0 on stdout. measure_coverage returns a decimal.
# - If the LANGUAGE tool fails for a reason of its own (segfault, OOM, panic):
#   the function emits ::error:: to stderr AND the main script does exit 2.
#   A tool error NEVER becomes a regression (which would be exit 1).
# - If the metric is OMITTED (the tool does not exist in the language):
#   - REMOVE the measurement line (base_X and pr_X) below.
#   - REMOVE the corresponding argument in render_text/render_json.
#   - Do NOT set it to 0 or null. The omission is literal.
# - If you ADD an extra metric: add base_X / pr_X vars here and
#   pass them to render_*. A unique snake_case ASCII name.
# - Bug 1 (contract): if the language has a deps manager, qg_resolve_deps
#   (in lib/measure.sh) MUST run for baseline AND PR BEFORE measuring. A
#   resolution failure = tool-error exit 2, NEVER a regressed build. Languages without
#   explicit resolution (rust/cargo, swift/SwiftPM) keep qg_resolve_deps
#   as a symmetry no-op.
# - LAW the declared toolchain/build-system is authoritative (contract section
#   "The declared toolchain/build-system is authoritative (LAW)"): qg_resolve_deps
#   (in lib/measure.sh) MUST detect the build-system/manager/toolchain the
#   project declares (lockfile, build-system file, wrapper like ./mvnw/
#   ./gradlew, a pinned-version directive like go.mod toolchain /
#   rust-toolchain.toml / swift-tools-version). If the gate does NOT support that
#   build-system OR cannot honor it exactly (tool absent,
#   pinned version not satisfiable) => tool-error: write to the $log
#   "::error::<cause> -- <user action> (silent substitution
#   would produce an incorrect result)" and return 1. NEVER a silent fallback
#   to another tool/version/manager. Reference pattern:
#   nodejs/lib/measure.sh qg_resolve_deps(). Validate with a fixture (step 17g).

# Bug 1: resolve baseline AND PR dependencies before measuring build/test.
if ! qg_resolve_deps "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-deps.log"; then
  echo "::error::failed to resolve {{LANGUAGE_SLUG}} dependencies (baseline) -- see $QG_LOG_DIR_ARG/base-deps.log" >&2
  exit 2
fi
if ! qg_resolve_deps "." "$QG_LOG_DIR_ARG/pr-deps.log"; then
  echo "::error::failed to resolve {{LANGUAGE_SLUG}} dependencies (PR) -- see $QG_LOG_DIR_ARG/pr-deps.log" >&2
  exit 2
fi

echo "-- measuring base --" >&2
base_fmt=$(count_fmt_errors "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-fmt.log")
base_lint=$(count_lint_errors "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-lint.log")
base_build=$(count_build_errors "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-build.log")
base_test=$(count_test_failures "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-test.log")
base_complex=$(count_complexity "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-complex.log")
base_cov=$(measure_coverage "$QG_BASELINE_DIR_ARG" "$QG_LOG_DIR_ARG/base-cov.json")

echo "-- measuring PR --" >&2
pr_fmt=$(count_fmt_errors "." "$QG_LOG_DIR_ARG/pr-fmt.log")
pr_lint=$(count_lint_errors "." "$QG_LOG_DIR_ARG/pr-lint.log")
pr_build=$(count_build_errors "." "$QG_LOG_DIR_ARG/pr-build.log")
pr_test=$(count_test_failures "." "$QG_LOG_DIR_ARG/pr-test.log")
pr_complex=$(count_complexity "." "$QG_LOG_DIR_ARG/pr-complex.log")
pr_cov=$(measure_coverage "." "$QG_LOG_DIR_ARG/pr-cov.json")

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "<detached>")
started_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
duration=$SECONDS

if [ "$QG_FORMAT_ARG" = "json" ]; then
  render_json "$branch" "$QG_BASE_REF_ARG" "$started_at" "$duration" \
    "$base_fmt" "$pr_fmt" \
    "$base_lint" "$pr_lint" \
    "$base_build" "$pr_build" \
    "$base_test" "$pr_test" \
    "$base_complex" "$pr_complex" \
    "$base_cov" "$pr_cov" "$QG_COV_MARGIN_ARG"
  exit $?
else
  render_text "$branch" "$QG_BASE_REF_ARG" "$QG_BASELINE_DIR_ARG" "$QG_COV_MARGIN_ARG" "$QG_LOG_DIR_ARG" \
    "$base_fmt" "$pr_fmt" \
    "$base_lint" "$pr_lint" \
    "$base_build" "$pr_build" \
    "$base_test" "$pr_test" \
    "$base_complex" "$pr_complex" \
    "$base_cov" "$pr_cov"
  exit $?
fi
