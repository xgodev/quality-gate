{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xgodev/quality-gate/contract-v1.schema.json",
  "title": "Quality Gate Output v1 (covers schema_version 1.0, 1.1 and 1.2; single result or monorepo envelope)",
  "oneOf": [
    { "$ref": "#/$defs/singleResult" },
    { "$ref": "#/$defs/monorepoResult" }
  ],
  "$defs": {
    "monorepoResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "aggregate_verdict", "results"],
      "properties": {
        "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
        "quick": { "const": true },
        "aggregate_verdict": { "enum": ["passed", "regressed", "failed", "bypassed"] },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/singleResult" }
        }
      }
    },
    "singleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "language", "branch", "base_ref", "started_at", "duration_seconds", "verdict", "bypass_reason", "metrics"],
      "properties": {
        "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
        "mode": { "enum": ["comparative", "absolute"] },
        "comment_quick": "Present and true only on a --quick run (schema 1.2): the heaviest metrics were deferred, reported as verdict skipped with null numbers, and excluded from the verdict.",
        "quick": { "const": true },
        "language": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "branch": { "type": "string" },
        "base_ref": { "type": ["string", "null"] },
        "started_at": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "integer", "minimum": 0 },
        "verdict": { "enum": ["passed", "regressed", "failed", "bypassed"] },
        "bypass_reason": { "type": ["string", "null"] },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "base": { "type": ["number", "null"], "minimum": 0 },
              "pr": { "type": ["number", "null"], "minimum": 0 },
              "delta": { "type": ["number", "null"] },
              "margin": { "type": ["number", "null"], "minimum": 0 },
              "value": { "type": ["number", "null"], "minimum": 0 },
              "threshold": { "type": ["number", "null"], "minimum": 0 },
              "verdict": { "enum": ["same", "improved", "regressed", "ok", "violated", "reported", "skipped"] }
            }
          }
        }
      },
      "allOf": [
        {
          "comment": "mode absent OR comparative => comparative metrics {name,base,pr,delta,verdict}",
          "if": {
            "not": {
              "properties": { "mode": { "const": "absolute" } },
              "required": ["mode"]
            }
          },
          "then": {
            "properties": {
              "verdict": { "enum": ["passed", "regressed", "bypassed"] },
              "metrics": {
                "items": {
                  "required": ["name", "base", "pr", "delta", "verdict"],
                  "properties": {
                    "verdict": { "enum": ["same", "improved", "regressed", "skipped"] }
                  }
                }
              }
            }
          }
        },
        {
          "comment": "mode absolute => absolute metrics {name,value,threshold,verdict}, base_ref null, global verdict passed|failed|bypassed",
          "if": {
            "properties": { "mode": { "const": "absolute" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "base_ref": { "type": "null" },
              "verdict": { "enum": ["passed", "failed", "bypassed"] },
              "metrics": {
                "items": {
                  "required": ["name", "value", "threshold", "verdict"],
                  "properties": {
                    "verdict": { "enum": ["ok", "violated", "reported", "skipped"] }
                  }
                }
              }
            }
          }
        },
        {
          "comment": "A metric is skipped only on a quick run, and then it carries NO numbers -- it was never measured.",
          "properties": {
            "metrics": {
              "items": {
                "if": { "properties": { "verdict": { "const": "skipped" } }, "required": ["verdict"] },
                "then": {
                  "properties": {
                    "base": { "type": "null" },
                    "pr": { "type": "null" },
                    "delta": { "type": "null" },
                    "margin": { "type": "null" },
                    "value": { "type": "null" },
                    "threshold": { "type": "null" }
                  }
                },
                "else": {
                  "properties": {
                    "base": { "type": "number" },
                    "pr": { "type": "number" },
                    "delta": { "type": "number" },
                    "margin": { "type": "number" },
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        {
          "comment": "A skipped metric requires schema 1.2 + quick: true -- a non-quick document may not report one.",
          "if": {
            "properties": {
              "metrics": { "contains": { "properties": { "verdict": { "const": "skipped" } }, "required": ["verdict"] } }
            },
            "required": ["metrics"]
          },
          "then": {
            "properties": {
              "schema_version": { "const": "1.2" },
              "quick": { "const": true }
            },
            "required": ["quick"]
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "bypassed" } } },
          "then": {
            "properties": {
              "bypass_reason": { "type": "string", "minLength": 1 },
              "metrics": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
